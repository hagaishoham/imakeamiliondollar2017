# OpenAI API Key - Required for transcription (Whisper) and TTS
OPENAI_API_KEY=sk-your-openai-api-key-here

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000
BASE_URL=http://localhost:8000

# Podcast Default Settings
PODCAST_TITLE=My YouTube Podcast
PODCAST_DESCRIPTION=Automatically generated podcast from YouTube videos
PODCAST_AUTHOR=Your Name
PODCAST_EMAIL=your@email.com
PODCAST_LANGUAGE=he

# TTS Settings (openai)
TTS_MODEL=tts-1
TTS_VOICE=alloy
# Available voices: alloy, echo, fable, onyx, nova, shimmer
